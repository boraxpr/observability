otelcol.receiver.otlp "openwebui" {
  http {
    
  }

  grpc {

  }

  output {
    metrics = [otelcol.processor.batch.openwebui.input]
    logs    = [otelcol.processor.batch.openwebui.input]
    traces  = [otelcol.processor.batch.openwebui.input]
  }
}

otelcol.processor.batch "openwebui" {
  output {
    metrics = [otelcol.exporter.prometheus.openwebui.input]
    logs    = [otelcol.exporter.loki.openwebui.input]
    traces  = [otelcol.exporter.otlp.openwebui.input]
  }
}

otelcol.exporter.loki "openwebui" {
  forward_to = [loki.write.openwebui.receiver]
}

loki.write "openwebui" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.prometheus "openwebui" {
  forward_to = [prometheus.remote_write.openwebui.receiver]
}

prometheus.remote_write "openwebui" {
  external_labels = {
    job = "openwebui",
    instance = "alloy",
  }
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.exporter.otlp "openwebui" {
  client {
    endpoint = "http://jaeger:4318"
    tls {
      insecure = true
    }
  }
}