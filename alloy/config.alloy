// META MONITORING 
// NOTE: DISABLE PROMETHEUS SELF METRICS FROM ALLOY (PUSH) IF USING NATIVE PROMETHEUS SERVICE DISCOVERY (PULL)
// prometheus.exporter.self "alloy" { }

// prometheus.scrape "alloy" {
// 	targets    = prometheus.exporter.self.alloy.targets
// 	forward_to = [otelcol.receiver.prometheus.alloy.receiver]
// }
// CONVERTER COMPONENT Prometheus -to- OTEL READ: https://grafana.com/docs/agent/latest/flow/reference/components/otelcol.receiver.prometheus/
// otelcol.receiver.prometheus "alloy" {
// 	output {
// 		metrics = [otelcol.processor.batch.main.input]
// 	}
// }

// MAIN PIPELINE
livedebugging {
	enabled = true
}

otelcol.receiver.otlp "main" {
	http { }

	grpc { }

	output {
		logs    = [otelcol.processor.memory_limiter.main.input]
		metrics = [otelcol.processor.memory_limiter.main.input]
		traces  = [otelcol.processor.memory_limiter.main.input]
	}
}

otelcol.processor.memory_limiter "main" {
	check_interval = "1s"

	limit_percentage       = 80
	spike_limit_percentage = 20

	output {
		metrics = [otelcol.processor.filter.drop_noise.input]
		logs    = [otelcol.processor.filter.drop_noise.input]
		traces  = [otelcol.processor.filter.drop_noise.input]
	}
}

otelcol.processor.filter "drop_noise" {
	error_mode = "ignore"
	// Drop noise from logs
	logs {
		log_record = [
			`IsString(body) and IsMatch(body, ".*_app.*")`,
			`IsString(body) and IsMatch(body, "/api/v1/models/model/profile/image")`,
			`IsString(body) and IsMatch(body, ".*static.*")`,
			// DROP HEALTH CHECKS
			`IsString(body) and IsMatch(body, "HEAD / ")`,
			`IsString(body) and IsMatch(body, "GET /api/version")`,
		]
	}

	output {
		logs    = [otelcol.processor.batch.main.input]
		metrics = [otelcol.processor.batch.main.input]
		traces  = [otelcol.processor.batch.main.input]
	}
}

otelcol.processor.batch "main" {
	send_batch_size     = 500
	send_batch_max_size = 1000

	output {
		metrics = [otelcol.exporter.prometheus.main.input]
		logs    = [otelcol.exporter.loki.main.input]
		traces  = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.loki "main" {
	forward_to = [loki.write.main.receiver]
}

loki.source.kubernetes_events "event" {
	forward_to = [loki.write.main.receiver]
}

loki.write "main" {
	endpoint {
		url = "http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push"
	}
}

otelcol.exporter.prometheus "main" {
	forward_to = [prometheus.remote_write.main.receiver]
}

prometheus.remote_write "main" {
	endpoint {
		url = "http://prometheus.monitoring.svc.cluster.local:9090/api/v1/write"
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "http://tempo.monitoring.svc.cluster.local:4317"

		tls {
			insecure             = true
			insecure_skip_verify = true
		}
	}
}
